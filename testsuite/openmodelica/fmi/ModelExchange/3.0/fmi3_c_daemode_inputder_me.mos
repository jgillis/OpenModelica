// name: fmi3_c_daemode_inputder_me.mos
// keywords: FMI 3.0 export Model Exchange daeMode fmi-ls-dae input derivatives
// status: correct
// teardown_command: rm -rf DaeModeInputDer*
//
// x = u ties a state to the input u (index 2): x is replaced by u and der(x) by
// der(u); a^2 = u + 1 is differentiated by index reduction to 2*a*der(a) = der(u).
// By default the derivative of an input is 0 (an FMI input is piecewise
// constant), which makes y = u and b = 0. With --fmiInputDerivatives der(u)
// becomes an additional input der(u) of the FMU (start 0, i.e. the default
// behaviour), which the importer sets like any other input, e.g. an optimizer
// that owns the trajectory of u: y = u + der(u), b = der(u)/(2*a). A der(u) the
// model writes itself (w) is the same input. v is never differentiated and gets
// no der(v).

setCommandLineOptions("--fmiSources=true --simCodeTarget=C+Rust"); getErrorString();
loadFile("fmi3_c_daemode_inputder_me.mo"); getErrorString();

// default: der(u) = 0
buildModelFMU(DaeModeInputDerC, version="3.0", fmuType="me"); getErrorString();
system("unzip -cqq DaeModeInputDerC.fmu modelDescription.xml | grep -E \"causality=\\\"input\\\"\" | sed \"s/^ *//\""); getErrorString();
system("unzip -cqq DaeModeInputDerC.fmu sources/DaeModeInputDerC_16dae.c | grep -E \"^ *\\(data->(localData\\[0\\]->realVars|simulationInfo->daeModeData->residualVars)\\[[0-9]+\\]\\)? */\\* (y|b|\\\\\\$DAEres[0-9]+) \" | sed \"s/^ *//\""); getErrorString();

setCommandLineOptions("--fmiInputDerivatives"); getErrorString();
buildModelFMU(DaeModeInputDerC, version="3.0", fmuType="me"); getErrorString();
system("unzip -cqq DaeModeInputDerC.fmu modelDescription.xml | grep -E \"causality=\\\"input\\\"\" | sed \"s/^ *//\""); getErrorString();
system("unzip -cqq DaeModeInputDerC.fmu extra/org.fmi-standard.fmi-ls-dae/fmi-ls-manifest.xml > DaeModeInputDerC_lsdae.xml"); getErrorString();
readFile("DaeModeInputDerC_lsdae.xml"); getErrorString();
system("unzip -cqq DaeModeInputDerC.fmu sources/DaeModeInputDerC_16dae.c | grep -E \"^ *\\(data->(localData\\[0\\]->realVars|simulationInfo->daeModeData->residualVars)\\[[0-9]+\\]\\)? */\\* (y|b|\\\\\\$DAEres[0-9]+) \" | sed \"s/^ *//\""); getErrorString();
// the DAE-mode Jacobian has a column for der(u) (realVars index 3)
system("unzip -cqq DaeModeInputDerC.fmu sources/DaeModeInputDerC_16dae.c | grep \"const int jacobian\" | sed \"s/^ *//\""); getErrorString();

// der(u) written in the model
buildModelFMU(DaeModeInputDerWrittenC, version="3.0", fmuType="me"); getErrorString();
system("unzip -cqq DaeModeInputDerWrittenC.fmu modelDescription.xml | grep -E \"causality=\\\"input\\\"\" | sed \"s/^ *//\""); getErrorString();
system("unzip -cqq DaeModeInputDerWrittenC.fmu sources/DaeModeInputDerWrittenC.c | grep -E \"^ *\\(data->localData\\[0\\]->realVars\\[[0-9]+\\]\\)? */\\* w \" | sed \"s/^ *//\""); getErrorString();


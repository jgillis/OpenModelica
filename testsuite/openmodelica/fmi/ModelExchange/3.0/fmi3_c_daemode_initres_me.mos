// name: fmi3_c_daemode_initres_me.mos
// keywords: FMI 3.0 export Model Exchange daeMode fmi-ls-dae initial equations
// status: correct
// teardown_command: rm -rf DaeModeInitResC*
//
// The initial equations of a `--daeMode` model as residuals, an OpenModelica
// extension of fmi-ls-dae for an importer that imposes them itself at the initial
// time (states, their derivatives and the algebraic variables free): Float64
// variables _D_INITres<i> after the residuals, listed with their structural
// dependencies in an org.openmodelica annotation of the manifest. The start value
// of the fixed=true x3 is not among them; w = x4 reads the auxiliary w, so its
// dependencies are what w's equation reads (x1, z, x3) and x4.

setCommandLineOptions("--fmiSources=true --simCodeTarget=C+Rust"); getErrorString();
loadFile("fmi3_c_daemode_initres_me.mo"); getErrorString();
buildModelFMU(DaeModeInitResC, version="3.0", fmuType="me"); getErrorString();

system("unzip -cqq DaeModeInitResC.fmu extra/org.fmi-standard.fmi-ls-dae/fmi-ls-manifest.xml > DaeModeInitResC_lsdae.xml"); getErrorString();
readFile("DaeModeInitResC_lsdae.xml"); getErrorString();

system("unzip -cqq DaeModeInitResC.fmu modelDescription.xml > DaeModeInitResC_md.xml"); getErrorString();
system("grep -E \"name=\\\"(x[1-4]|der\\(x[1-4]\\)|y|z|w|_D_daeMode|_D_DAEres[0-9]*|_D_INITres[0-9]*)\\\"\" DaeModeInitResC_md.xml | sed \"s/^ *//\""); getErrorString();

system("unzip -cqq DaeModeInitResC.fmu sources/DaeModeInitResC_16dae.c | sed -n \"/^int DaeModeInitResC_evaluateInitialDAEResiduals/,/^}/p\" | grep \"res\\[\" | sed \"s/^ *//\""); getErrorString();

// The DAE-mode Jacobian the FMU answers fmi3GetDirectionalDerivative from has
// the initial residuals as rows after the residuals: the variable (realVars
// index) of each column and the residual of each row.
system("unzip -cqq DaeModeInitResC.fmu sources/DaeModeInitResC_16dae.c | grep \"const int jacobian\" | sed \"s/^ *//\""); getErrorString();

